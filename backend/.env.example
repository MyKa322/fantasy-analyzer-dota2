# Скопируйте в backend/.env и заполните при необходимости.
# Все переменные опциональны: без ключей приложение работает на публичном
# OpenDota (60 запросов/мин, 2000/сутки).

# ANALYZER_OPENDOTA_API_KEY=
# ANALYZER_STRATZ_API_TOKEN=
# ANALYZER_STEAM_API_KEY=

# SQLite по умолчанию; для Postgres достаточно сменить строку.
# ANALYZER_DATABASE_URL=postgresql+psycopg://user:pass@localhost/analyzer

# ANALYZER_HISTORY_DAYS=120
# ANALYZER_RATING_PERIOD_DAYS=7
# ANALYZER_SIMULATIONS=20000
